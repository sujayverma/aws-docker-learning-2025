#! /usr/bin/bash

if [ -z $1 ]; then
    echo "provide the table name eg: ./backend-flask/bin/ddb/drop tablename"
    exit 1

fi

TABLE_NAME=$1

if [ "$2" = "prod" ]; then
    ENDPOINT_URL=""
else
    ENDPOINT_URL="--endpoint-url=http://localhost:8000"
fi

aws dynamodb delete-table $ENDPOINT_URL \
    --table-name $TABLE_NAME